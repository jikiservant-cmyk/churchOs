# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SERVER ONLY. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=""

# ── App URL / CSRF ──────────────────────────────────────────────────────────
# Public origin of this deployment, e.g. https://app.example.com
NEXT_PUBLIC_APP_URL=""
APP_URL=""
# Extra origins allowed to POST cookie-authenticated requests (comma-separated). Usually empty.
ALLOWED_ORIGINS=""
# Only set to "true" if the app is embedded cross-site (iframe). Switches auth cookies to SameSite=None.
# ALLOW_CROSS_SITE_COOKIES="false"
# Origins allowed to embed the app (space-separated). Defaults to 'self'.
# FRAME_ANCESTORS="'self'"

# ── Usher sessions ──────────────────────────────────────────────────────────
# REQUIRED, >= 32 chars, NO fallback. Generate with: openssl rand -hex 32
# Changing it signs every usher out.
USHER_JWT_SECRET=""

# ── SMS queue worker (/api/sms/process-queue) ───────────────────────────────
# The endpoint is DISABLED unless one of these (>= 16 chars) is set.
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
QUEUE_PROCESSOR_SECRET=""
CRON_SECRET=""

# ── Najiki (payments + SMS) ─────────────────────────────────────────────────
NAJIKI_API_URL="https://najiki.netlify.app"
NAJIKI_API_KEY=""
# Must equal the Application `code` in Najiki EXACTLY (case-sensitive; Najiki's seed uses "church").
NAJIKI_APPLICATION_CODE="church"
# Najiki signs notifications with the Application's webhook secret (or its API key when none is set).
# Put that value here. The webhook also accepts NAJIKI_API_KEY. It rejects everything if neither is set.
NAJIKI_WEBHOOK_SECRET=""
# Najiki-side setup required (Setup page): Application baseUrl = this app's public URL,
# webhookPath = /api/najiki/webhook, and a payment type with code SMS_TOPUP for this application.

# ── Africa's Talking (SMS fallback) ─────────────────────────────────────────
AT_API_KEY=""
AT_USERNAME=""

# ── Gemini (message drafting) ───────────────────────────────────────────────
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
